{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "includes": ["**/*.{mjs,json,md}"],
  "excludes": ["node_modules/**", "build/**"],
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.96.1.wasm",
    "https://plugins.dprint.dev/json-0.25.1.wasm",
    "https://plugins.dprint.dev/markdown-0.26.0.wasm"
  ],
  "typescript": {
    "lineWidth": 100,
    "indentWidth": 2,
    "useTabs": false,
    "semiColons": "always",
    "quoteStyle": "alwaysSingle",
    "quoteProps": "asNeeded",
    "arrowFunction.useParentheses": "force",
    "functionExpression.spaceBeforeParentheses": true
  }
}
